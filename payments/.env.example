# PesaJet Payments Integration Configuration

# The port where this demo application runs
PORT=8001

# PesaJet API Base URL
# Local development: http://localhost:3000/api/v1
# Staging/Production: https://api.pesajet.com/api/v1
PESAJET_API_BASE_URL=http://localhost:3000/api/v1

# Merchant Public API Key (Obtain from Merchant Dashboard > API Keys)
# Required for all REST requests via X-API-Key header
PESAJET_API_KEY=pk_test_merchant_api_key_here

# Merchant Webhook Signing Secret (Optional, for combined webhook verification)
PESAJET_WEBHOOK_SECRET=whsec_your_secret_here

